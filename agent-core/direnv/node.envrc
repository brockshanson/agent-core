# Canonical .envrc for a Node repo.
#
# Install: copy to repo root as `.envrc`, then run `direnv allow`.
#   cp ~/.local/share/chezmoi/agent-core/direnv/node.envrc .envrc
#   direnv allow
#
# Layers node_modules/.bin on PATH so repo-local CLIs (eslint, tsc,
# jest, vite, …) resolve without `npx` or `./node_modules/.bin/…`.
# Node version itself is assumed to come from an external version
# manager (volta, fnm, nvm, asdf) — direnv doesn't try to install node.

PATH_add node_modules/.bin

# Load repo-local overrides if present.
dotenv_if_exists

