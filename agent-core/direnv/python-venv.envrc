# Canonical .envrc for a Python repo with a .venv/, managed by uv.
#
# Install: copy to repo root as `.envrc`, then run `direnv allow`.
#   cp ~/.local/share/chezmoi/agent-core/direnv/python-venv.envrc .envrc
#   direnv allow
#
# Requires uv. With a pyproject.toml, runs `uv sync` on every load (so .venv
# tracks pyproject.toml/uv.lock; uv sync also removes packages the lock does
# not name). Without one, creates .venv/ with `uv venv` on first entry. Then
# activates .venv/ directly and loads any .env file at repo root.
#
# Why not `layout python .venv/bin/python`: that helper ignores .venv/ and
# builds a second venv under .direnv/python-X.Y with the stdlib venv module.
# On Ubuntu without the python3.X-venv package that build fails, and
# VIRTUAL_ENV is left pointing at the broken copy.

if ! command -v uv >/dev/null; then
    log_error "python-venv.envrc needs uv and it is not on PATH: https://docs.astral.sh/uv/"
    exit 1
fi

# Pin uv's project env to .venv/ even if UV_PROJECT_ENVIRONMENT is set
# elsewhere, so `uv sync` and the activation below name the same directory.
export UV_PROJECT_ENVIRONMENT="$PWD/.venv"

if [ -f pyproject.toml ]; then
    watch_file pyproject.toml uv.lock
    uv sync || { log_error "uv sync failed; .venv not activated"; exit 1; }
elif [ ! -d .venv ]; then
    uv venv .venv || { log_error "uv venv failed; .venv not activated"; exit 1; }
fi

# What `source .venv/bin/activate` does, in a form direnv can tear down
# on leaving the directory.
export VIRTUAL_ENV="$PWD/.venv"
PATH_add .venv/bin
unset PYTHONHOME

# Load repo-local overrides if present (.env must be gitignored; this
# file can reference secrets but should not be a secret itself).
dotenv_if_exists
