# Canonical .envrc for a repo that just needs .env loading.
#
# Install: copy to repo root as `.envrc`, then run `direnv allow`.
#   cp ~/.local/share/chezmoi/agent-core/direnv/generic.envrc .envrc
#   direnv allow
#
# Loads .env on entry, unloads on leave. Optionally extends PATH with
# a repo-local bin/ if the repo ships helper scripts.

dotenv_if_exists

# Uncomment if the repo has a bin/ with scripts that should be on PATH
# while you're working in the repo:
# PATH_add bin
