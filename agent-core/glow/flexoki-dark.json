{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#cecdc3", "margin": 2 },
  "block_quote": { "color": "#878580", "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#4385be", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#100f0f", "background_color": "#4385be", "bold": true },
  "h2": { "prefix": "## ", "color": "#8b7ec8" },
  "h3": { "prefix": "### ", "color": "#3aa99f" },
  "h4": { "prefix": "#### ", "color": "#879a39" },
  "h5": { "prefix": "##### ", "color": "#d0a215" },
  "h6": { "prefix": "###### ", "color": "#878580", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "bold": true },
  "hr": { "color": "#6f6e69", "format": "\n──────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#4385be", "underline": true },
  "link_text": { "color": "#3aa99f", "bold": true },
  "image": { "color": "#ce5d97", "underline": true },
  "image_text": { "color": "#878580", "format": "Image: {{.text}} →" },
  "code": { "prefix": " ", "suffix": " ", "color": "#d14d41", "background_color": "#282726" },
  "code_block": {
    "color": "#cecdc3", "margin": 2,
    "chroma": {
      "text": { "color": "#cecdc3" },
      "error": { "color": "#100f0f", "background_color": "#d14d41" },
      "comment": { "color": "#6f6e69", "italic": true },
      "comment_preproc": { "color": "#da702c" },
      "keyword": { "color": "#879a39" },
      "keyword_reserved": { "color": "#879a39" },
      "keyword_namespace": { "color": "#4385be" },
      "keyword_type": { "color": "#d0a215" },
      "operator": { "color": "#878580" },
      "punctuation": { "color": "#878580" },
      "name": { "color": "#cecdc3" },
      "name_builtin": { "color": "#ce5d97" },
      "name_tag": { "color": "#d14d41" },
      "name_attribute": { "color": "#4385be" },
      "name_class": { "color": "#d0a215", "bold": true },
      "name_constant": { "color": "#8b7ec8" },
      "name_decorator": { "color": "#8b7ec8" },
      "name_exception": { "color": "#d14d41" },
      "name_function": { "color": "#da702c" },
      "name_other": { "color": "#cecdc3" },
      "literal_number": { "color": "#8b7ec8" },
      "literal_string": { "color": "#3aa99f" },
      "literal_string_escape": { "color": "#24837b" },
      "generic_deleted": { "color": "#d14d41" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "#879a39" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#878580" },
      "background": { "background_color": "#1c1b1a" }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
