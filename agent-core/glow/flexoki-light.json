{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#100f0f", "margin": 2 },
  "block_quote": { "color": "#6f6e69", "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#205ea6", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#fffcf0", "background_color": "#205ea6", "bold": true },
  "h2": { "prefix": "## ", "color": "#5e409d" },
  "h3": { "prefix": "### ", "color": "#24837b" },
  "h4": { "prefix": "#### ", "color": "#66800b" },
  "h5": { "prefix": "##### ", "color": "#ad8301" },
  "h6": { "prefix": "###### ", "color": "#6f6e69", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "bold": true },
  "hr": { "color": "#b7b5ac", "format": "\n──────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#205ea6", "underline": true },
  "link_text": { "color": "#24837b", "bold": true },
  "image": { "color": "#a02f6f", "underline": true },
  "image_text": { "color": "#6f6e69", "format": "Image: {{.text}} →" },
  "code": { "prefix": " ", "suffix": " ", "color": "#af3029", "background_color": "#e6e4d9" },
  "code_block": {
    "color": "#100f0f", "margin": 2,
    "chroma": {
      "text": { "color": "#100f0f" },
      "error": { "color": "#fffcf0", "background_color": "#af3029" },
      "comment": { "color": "#878580", "italic": true },
      "comment_preproc": { "color": "#bc5215" },
      "keyword": { "color": "#66800b" },
      "keyword_reserved": { "color": "#66800b" },
      "keyword_namespace": { "color": "#205ea6" },
      "keyword_type": { "color": "#ad8301" },
      "operator": { "color": "#6f6e69" },
      "punctuation": { "color": "#6f6e69" },
      "name": { "color": "#100f0f" },
      "name_builtin": { "color": "#a02f6f" },
      "name_tag": { "color": "#af3029" },
      "name_attribute": { "color": "#205ea6" },
      "name_class": { "color": "#ad8301", "bold": true },
      "name_constant": { "color": "#5e409d" },
      "name_decorator": { "color": "#5e409d" },
      "name_exception": { "color": "#af3029" },
      "name_function": { "color": "#bc5215" },
      "name_other": { "color": "#100f0f" },
      "literal_number": { "color": "#5e409d" },
      "literal_string": { "color": "#24837b" },
      "literal_string_escape": { "color": "#3aa99f" },
      "generic_deleted": { "color": "#af3029" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "#66800b" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#6f6e69" },
      "background": { "background_color": "#f2f0e5" }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
