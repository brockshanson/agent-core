{{- /*
   This file is managed by chezmoi. Codex CLI does NOT support @-imports,
   so the portable core and the current host's context are flat-concatenated
   into this file at `chezmoi apply` time. Edits to ~/.codex/AGENTS.md will
   be overwritten. Edit the sources:
     - Portable content : $(chezmoi source-path)/agent-core/AGENTS.core.md
     - Fleet-only       : $(chezmoi source-path)/fleet/AGENTS.fleet.md
     - Host-specific    : $(chezmoi source-path)/hosts/<hostname>/host.md

   Codex has a default `project_doc_max_bytes` of 32 KiB and silently
   truncates past that. If the combined file approaches that ceiling,
   either trim content or raise the cap in dot_codex/config.toml.
*/ -}}
{{- /* Host doc lookup: the short host name comes from .chezmoitemplates/host-id
     (why not .chezmoi.hostname is explained there). The lookup is stat-guarded
     and falls back to hosts/_generic so an unregistered machine cannot
     hard-fail apply. */ -}}
{{- /* Fleet half (claude-dotfiles-6uo): infrastructure-coupled conventions.
     Stat-guarded on purpose -- the public agent-core repo does not contain
     this file, so the split gates by CONSTRUCTION rather than by a runtime
     conditional. Absent file == absent infrastructure. */ -}}
{{- $fleetCore := joinPath .chezmoi.sourceDir "fleet" "AGENTS.fleet.md" -}}
{{- $host := includeTemplate "host-id" . | trim -}}
{{- $hostDoc := joinPath .chezmoi.sourceDir "hosts" $host "host.md" -}}
{{- if not (stat $hostDoc) -}}
{{-   $hostDoc = joinPath .chezmoi.sourceDir "hosts" "_generic" "host.md" -}}
{{- end -}}

