{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/logger/init_session.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/session-start-handoff.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/chezmoi-staleness.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/logger/log_tool.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/logger/log_tool.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/logger/log_tool.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/logger/log_event.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/logger/log_event.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/post-compact-handoff.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/status.sh"
  },
  "alwaysThinkingEnabled": true,
  "showThinkingSummaries": true,
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(command -v:*)"
    ]
  },
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_LOG_RETENTION_DAYS": "30",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  }
}
